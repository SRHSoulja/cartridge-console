{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SRHSoulja/cartridge-console/main/schemas/cartridge-manifest-v1.schema.json",
  "title": "CartridgeManifestV1",
  "description": "Authoritative JSON Schema for Console Platform Cartridge Manifest V1 (RFC 8785 / JCS deterministic serialization)",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "cartridgeId",
    "name",
    "version",
    "runtime",
    "entry",
    "permissions"
  ],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Manifest schema version, must be '1.0.0'"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-_]+$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Human-readable lowercase alphanumeric slug identifier"
    },
    "cartridgeId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Canonical 32-byte hexadecimal identifier registered in CartridgeRegistry"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Human-readable title of the cartridge"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version adhering strictly to SemVer 2.0.0"
    },
    "description": {
      "type": "string",
      "maxLength": 512,
      "description": "Brief summary of the cartridge application"
    },
    "runtime": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(\\^|~|>=|<=|>|<|=)?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z.-]+))?$",
          "description": "Console Runtime compatibility range (e.g. '^0.2.0')"
        },
        "transport": {
          "type": "string",
          "enum": ["auto", "direct", "bridge"],
          "default": "auto",
          "description": "Host communication adapter"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["path", "mediaType", "digest", "size"],
      "additionalProperties": false,
      "description": "Primary executable entry point resource descriptor",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Entry document relative path (e.g. 'index.html')"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "description": "MIME media type (e.g. 'text/html', 'application/octet-stream', 'application/wasm')"
        },
        "encoding": {
          "type": "string",
          "enum": ["identity", "deflate"],
          "default": "identity",
          "description": "Content encoding scheme"
        },
        "digest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Keccak-256 digest of the stored payload chunk(s)"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte count of the stored payload"
        },
        "decodedDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Keccak-256 digest of uncompressed payload when encoding is 'deflate'"
        },
        "decodedSize": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte count of uncompressed payload when encoding is 'deflate'"
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "description": "Ordered array of ContentStore chunk digests"
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Static assets and companion files referenced by the cartridge",
      "items": {
        "type": "object",
        "required": ["path", "mediaType", "digest", "size"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "encoding": {
            "type": "string",
            "enum": ["identity", "deflate"],
            "default": "identity"
          },
          "digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "decodedDigest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "decodedSize": {
            "type": "integer",
            "minimum": 0
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "External on-chain modules or shared libraries",
      "items": {
        "type": "object",
        "required": ["name", "digest", "version"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["chains"],
      "additionalProperties": false,
      "description": "Explicit capabilities and contract targets requested by the cartridge",
      "properties": {
        "chains": {
          "type": "array",
          "minItems": 1,
          "description": "CAIP-2 blockchain identifiers requested by this cartridge",
          "items": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
          }
        },
        "contracts": {
          "type": "array",
          "description": "Target smart contract rules",
          "items": {
            "type": "object",
            "required": ["address"],
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte EVM contract address"
              },
              "name": {
                "type": "string",
                "description": "Contract label"
              },
              "writes": {
                "type": "boolean",
                "default": false,
                "description": "Whether write transactions are requested"
              },
              "allowedSelectors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{8}$"
                },
                "description": "List of 4-byte function selectors"
              },
              "allowNativeValue": {
                "type": "boolean",
                "default": false,
                "description": "Whether native token value transfer is requested"
              },
              "maxValueWei": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "default": "0",
                "description": "Maximum permitted native value per transaction in wei"
              },
              "isElevated": {
                "type": "boolean",
                "default": false,
                "description": "Whether elevated asset operations (approve, transfer, permit) are requested"
              },
              "argumentConstraints": {
                "type": "object",
                "additionalProperties": true,
                "description": "Positional or spender argument constraints"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional human metadata",
      "properties": {
        "author": { "type": "string" },
        "license": { "type": "string" },
        "repository": { "type": "string" },
        "website": { "type": "string" }
      }
    }
  }
}
